# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local content fallback (used only when Supabase is not configured)
/data

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw uploaded photo archive (staging only; not served)
/public/photos/_originals/

# local-only photo comparison samples
public/photos/_vibrancy-sample/
